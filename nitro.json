{
	"$schema": "https://nitro.margelo.com/nitro.schema.json",
	"cxxNamespace": ["watchnext"],
	"ios": {
		"iosModuleName": "WatchNext"
	},
	"android": {
		"androidNamespace": ["watchnext"],
		"androidCxxLibName": "WatchNext"
	},
	"autolinking": {
