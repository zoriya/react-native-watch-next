{
	"name": "react-native-watch-next",
	"version": "0.0.0-development",
	"description": "Publish programs to the android tv watch next row",
	"main": "./lib/commonjs/index.js",
	"module": "./lib/module/index.js",
	"types": "./lib/typescript/src/index.d.ts",
	"react-native": "src/index",
	"source": "src/index",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"release": "semantic-release",
		"build": "bun run typecheck && bob build",
		"prepare": "bun run build",
		"codegen": "nitrogen --logLevel=\"debug\" && node post-script.js",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format": "biome format .",
		"format:fix": "biome format . --write"
	},
	"keywords": [
		"react-native",
		"android-tv",
		"watch-next"
	],
	"files": [
		"src",
		"lib",
		"nitrogen",
		"nitro.json",
		"android/build.gradle",
		"android/fix-prefab.gradle",
		"android/gradle.properties",
		"android/CMakeLists.txt",
		"android/src",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zoriya/react-native-watch-next.git"
	},
	"author": "Zoe Roux",
	"license": "MIT",
	"bugs": "https://github.com/zoriya/react-native-watch-next/issues",
	"homepage": "https://github.com/zoriya/react-native-watch-next#readme",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/react": "19.2.17",
		"nitrogen": "0.37.1",
		"react": "19.2.3",
		"react-native": "0.86.0",
		"react-native-builder-bob": "^0.43.2",
		"react-native-nitro-modules": "0.37.1",
		"conventional-changelog-conventionalcommits": "^10.2.1",
		"semantic-release": "^25.0.7",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*",
		"react-native-nitro-modules": ">=0.37.0"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			"commonjs",
			"module",
			[
				"typescript",
				{
					"project": "tsconfig.json"
				}
			]
		]
	}
}
